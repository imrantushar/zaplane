{
  "slug": "zaplane",
  "textdomain": "zaplane",
  "mainFile": "zaplane.php",
  "languages": "languages",
  "zipName": "{slug}.{version}.zip",
  "outputDir": "..",
  "composer": {
    "flags": [
      "--no-dev",
      "--optimize-autoloader",
      "--prefer-dist",
      "--no-interaction"
    ]
  },
  "zip": {
    "strictVendor": true
  },
  "autoDownloadTools": true,
  "toolVersions": {
    "wpCli": "2.12.0"
  },
  "steps": {
    "manifest": true,
    "js": true,
    "composer": true,
    "strauss": false,
    "pot": true,
    "zip": true
  },
  "manifest": {
    "command": "wp zaplane build:integration"
  },
  "js": {
    "install": "auto",
    "buildScript": "build"
  }
}
