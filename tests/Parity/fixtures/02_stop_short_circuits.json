{
  "name": "stop_short_circuits",
  "graph": {
    "nodes": [
      { "id": "trigger-1", "type": "trigger", "data": { "app": "webhook" } },
      { "id": "stop-1",    "type": "action",  "data": { "app": "stop", "config": { "reason": "abort" } } },
      { "id": "after",     "type": "action",  "data": { "app": "set",  "config": { "assignments": { "should_not_run": true } } } }
    ],
    "edges": [
      { "id": "e1", "source": "trigger-1", "target": "stop-1" },
      { "id": "e2", "source": "stop-1",    "target": "after" }
    ]
  },
  "input": { "marker": "x" },
  "expected_outputs": [
    { "node_id": "stop-1", "output": { "_stop": true, "_stop_as": "success", "reason": "abort" } }
  ]
}
