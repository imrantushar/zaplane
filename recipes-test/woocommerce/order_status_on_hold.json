{
  "name": "woocommerce-order_status_on_hold",
  "integration": "woocommerce",
  "required_plugins": ["woocommerce/woocommerce.php"],
  "setup": { "factory": "create_wc_order", "args": { "status": "on-hold", "total": 50 } },
  "node": {
    "kind": "trigger",
    "event": "order_status_on_hold",
    "config": {},
    "input": ["{{order_id}}", "{{order}}"]
  },
  "expect": { "not_false": true, "has_keys": ["order_id", "status"] }
}
