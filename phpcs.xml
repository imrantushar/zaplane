<?xml version="1.0"?>
<ruleset name="WordPress Coding Standards for Plugins">
	<description>Generally-applicable sniffs for WordPress plugins</description>

	<!-- PHP 7.4 and higher. -->
	<config name="testVersion" value="7.4-"/>
	<rule ref="PHPCompatibilityWP"/>
	<!-- Check all PHP files in directory tree by default. -->
	<arg name="extensions" value="php"/>
	<file>.</file>

	<!-- Exclude lib -->
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/autoload/*</exclude-pattern>
	<exclude-pattern>*/library/*</exclude-pattern>
	<exclude-pattern>*/lib/*</exclude-pattern>
	<exclude-pattern>*/assets/*</exclude-pattern>
	<exclude-pattern>*/dev_zaplane/*</exclude-pattern>

	<!-- Dev-only files (not shipped to WordPress) -->
	<exclude-pattern>*/tests/*</exclude-pattern>
	<exclude-pattern>*/includes/framework/console/*</exclude-pattern>
	<exclude-pattern>*/includes/commands/*</exclude-pattern>
	<exclude-pattern>*/docs/*</exclude-pattern>

	<!-- PHP 7.4 and higher. -->
    <config name="testVersion" value="7.4-"/>

	<!-- Arguments - extension, parallel, colors, show porgress, Show sniff codes in all reports -->
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="20"/>
	<arg name="colors"/>
    <arg value="sp"/>
	<arg value="s"/>

	<!-- Plugin prefix for global functions, classes, etc. -->
	<config name="minimum_supported_wp_version" value="5.0"/>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="zaplane"/>
				<element value="Zaplane"/>
			</property>
		</properties>
	</rule>

	<!-- Rules -->
	<rule ref="WordPress-Core" />
	<rule ref="WordPress-Docs" />

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="zaplane"/>
			</property>
		</properties>
	</rule>

	<!-- WPCS 3 dropped the allowCamelCase property; camelCase is allowed by
	     excluding the specific codes further down instead. -->

	<!-- Short array syntax is used throughout and is deliberately allowed. WPCS 3
	     moved this sniff from Generic.Arrays to Universal.Arrays; both are listed
	     so the intent survives either version. -->
	<rule ref="Generic.Arrays.DisallowShortArraySyntax.Found">
		<severity>0</severity>
	</rule>
	<rule ref="Universal.Arrays.DisallowShortArraySyntax.Found">
		<severity>0</severity>
	</rule>

	<!-- Exclude rules -->
	<rule ref="WordPress-Core">
		<exclude name="WordPress.Files.FileName.InvalidClassFileName" />
	</rule>

	<rule ref="Squiz.Commenting">
        <exclude name="Squiz.Commenting.FileComment"/>
		<exclude name="Squiz.Commenting.PostStatementComment"/>
    </rule>

	<rule ref="WordPress-Extra">
		<!-- Capital_P_Dangit auto-"corrects" the string "wordpress" to "WordPress"
		     even inside code literals (slugs, provider values, icon filenames),
		     which silently breaks logic. Never let phpcbf rewrite these. -->
		<exclude name="WordPress.WP.CapitalPDangit.MisspelledInText" />
		<exclude name="WordPress.WP.CapitalPDangit.MisspelledInComment" />
		<exclude name="WordPress.WP.CapitalPDangit" />
		<exclude name="Generic.Commenting.DocComment.MissingShort" />
		<exclude name="Generic.Formatting.MultipleStatementAlignment" />
		<exclude name="Generic.Arrays.DisallowShortArraySyntax.Found" />
		<exclude name="Squiz.Commenting.ClassComment.Missing" />
		<exclude name="Squiz.Commenting.FileComment.Missing" />
		<exclude name="Squiz.Commenting.FunctionComment.Missing" />
		<exclude name="Squiz.Commenting.FunctionComment.MissingParamComment" />
		<exclude name="Squiz.Commenting.VariableComment.Missing" />
		<exclude name="Squiz.PHP.EmbeddedPhp.ContentBeforeOpen" />
		<exclude name="Squiz.PHP.EmbeddedPhp.ContentAfterOpen" />
		<exclude name="Squiz.PHP.EmbeddedPhp.ContentBeforeEnd" />
		<exclude name="Squiz.PHP.EmbeddedPhp.ContentAfterEnd" />
		<exclude name="WordPress.Arrays.MultipleStatementAlignment" />
		<exclude name="WordPress.Files.FileName.InvalidClassFileName" />
		<exclude name="WordPress.WP.I18n.MissingTranslatorsComment" />
		<exclude name="WordPress.WP.I18n.NonSingularStringLiteralSingle" />
		<exclude name="WordPress.WP.I18n.NonSingularStringLiteralPlural" />
		<exclude name="WordPress.WP.EnqueuedResources.NonEnqueuedStylesheet" />
		<exclude name="PEAR.Functions.FunctionCallSignature.ContentAfterOpenBracket" />
		<exclude name="PEAR.Functions.FunctionCallSignature.MultipleArguments" />
		<exclude name="PEAR.Functions.FunctionCallSignature.CloseBracketLine" />
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase" />
		<exclude name="WordPress.NamingConventions.ValidVariableName.VariableNotSnakeCase" />
		<exclude name="Squiz.Commenting.InlineComment.InvalidEndChar" />
		<exclude name="WordPress.NamingConventions.ValidHookName.UseUnderscores" />
		<exclude name="WordPress.NamingConventions.ValidHookName.NotLowercase" />
		<exclude name="WordPress.WP.DiscouragedFunctions.wp_reset_query_wp_reset_query" />
		<exclude name="WordPress.Arrays.CommaAfterArrayItem.NoComma" />
		<!-- Renamed in WPCS 3; the rule above no longer matches on its own. -->
		<exclude name="NormalizedArrays.Arrays.CommaAfterLast.MissingMultiLine" />
		<exclude name="NormalizedArrays.Arrays.CommaAfterLast.MissingSingleLine" />
		<exclude name="WordPress.NamingConventions.ValidVariableName.InterpolatedVariableNotSnakeCase" />
		<exclude name="WordPress.NamingConventions.ValidVariableName.PropertyNotSnakeCase" />
		<exclude name="WordPress.NamingConventions.ValidVariableName.UsedPropertyNotSnakeCase" />
		<exclude name="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid" />
	</rule>

	<!-- WPCS 3 reads the shared minimum_supported_wp_version config set above
	     rather than a per-sniff minimum_supported_version property. -->
	<rule ref="WordPress.NamingConventions.ValidHookName">
		<properties>
			<property name="additionalWordDelimiters" value="/-" />
		</properties>
	</rule>
</ruleset>